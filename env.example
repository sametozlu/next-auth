# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-secret

# Auth0
AUTH0_ISSUER=https://YOUR_TENANT_REGION.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Optional: roles namespace for Auth0 rules/actions
# Example: https://example.com/claims
AUTH0_ROLES_NAMESPACE=


